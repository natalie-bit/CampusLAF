<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_grey"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <!-- Logo placeholder: swap this ImageView's src for your logo later -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="CampusLAF logo"
            app:tint="@color/brand_blue"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- App title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CampusLAF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="40dp"
            android:text="@string/tagline"
            android:textSize="14sp"
            android:textColor="@color/text_light" />

        <!-- Email field -->
        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/email_hint"
            android:inputType="textEmailAddress"
            android:background="@android:drawable/edit_text"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <!-- Password field -->
        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/password_hint"
            android:inputType="textPassword"
            android:background="@android:drawable/edit_text"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <!-- Log in button (email/password) -->
        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/log_in"
            android:textColor="@color/card_white"
            android:backgroundTint="@color/brand_blue" />

        <!-- Sign up link -->
        <TextView
            android:id="@+id/signupLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create_account"
            android:textColor="@color/brand_blue"
            android:padding="8dp" />

        <!-- Divider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:text="@string/or_divider"
            android:textColor="@color/text_faint" />

        <!-- Google sign-in button -->
        <Button
            android:id="@+id/googleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/continue_google"
            android:textColor="#2D3748"
            android:backgroundTint="@color/card_white" />

    </LinearLayout>
</ScrollView>